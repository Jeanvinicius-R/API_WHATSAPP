# Copie este arquivo para ".env" e ajuste. O ".env" NÃO vai para o Git.

# Porta e interface. 0.0.0.0 = aceita celulares na mesma rede (necessário para o QR Code). A área /admin continua só neste computador.
PORT=3000
HOST=0.0.0.0

# Token de acesso à área administrativa (/admin). Use algo longo e aleatório.
# Se ficar vazio, um token temporário é gerado a cada início e exibido no terminal.
ADMIN_TOKEN=

# Liga o WhatsApp (whatsapp-web.js). Use "false" para rodar só em modo demonstração.
WHATSAPP_ENABLED=true

# Inicia já no modo demonstração (nenhuma mensagem real é enviada).
DEMO_MODE=false

# Endereço que o QR Code abre no celular do visitante. Vazio = http://IP-DO-NOTEBOOK:PORTA (celular e notebook no mesmo Wi-Fi).
# Para funcionar também com dados móveis, use a versão online: https://SEU-USUARIO.github.io/API_WHATSAPP (o contador ao vivo só conta visitas no servidor).
PUBLIC_URL=

# Caminho do Chrome/Edge instalado, se o Chromium do Puppeteer não for baixado.
# Ex.: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=

# Limites de envio (tudo em memória; zera ao reiniciar)
MAX_SENDS_PER_NUMBER=1
MAX_SENDS_PER_HOUR=40
SEND_RATE_LIMIT_PER_MINUTE=10

# Pausa visual (ms) entre as etapas da animação "O que acontece por trás do botão".
# Não altera o envio; só deixa a plateia acompanhar. 0 desliga.
STEP_PAUSE_MS=450
